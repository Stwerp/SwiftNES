# icebreaker.pcf
# iCEbreaker iCE40UP5K pin constraints for usb_hid_host
#
# USB frontend: icepi-zero compatible (27R series, TPD2EUSB30A ESD, 15k pull-downs)
# USB connected to PMOD1A:
#   PMOD1A pin 1 (FPGA pin 4)  -> D0+ -> usb_dp
#   PMOD1A pin 2 (FPGA pin 2)  -> D0- -> usb_dm
#
# USBD_PULL_D+ and USBD_PULL_D- must be tied to GND for host mode.

# 12 MHz on-board crystal
set_io clk_12   35

# USB1 — single device currently wired in this port
set_io usb_dp   4    # USB1_DP — J2 pin 1 -> PMOD1A pin 1
set_io usb_dm   47   # USB1_DN — J2 pin 3 -> PMOD1A pin 3

# USB2 — not used yet, reserved for future dual-port expansion
# set_io usb2_dp  3
# set_io usb2_dm  46

# Scope probe mirror — PMOD1B
set_io probe_dp  43   # P1B1 — mirrors usb_dp_i
set_io probe_dm  38   # P1B2 — mirrors usb_dm_i

# Timing constraint
set_frequency clk_96 96